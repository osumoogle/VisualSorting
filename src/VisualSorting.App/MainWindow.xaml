<Window x:Class="VisualSorting.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sorting Visualizer"
        Width="1240" Height="760"
        MinWidth="900" MinHeight="520"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <!-- Inherited foreground reaches plain TextBlocks only; Buttons/ComboBoxes keep
         their theme style's dark text, which wins over inheritance. -->
    <DockPanel TextBlock.Foreground="{DynamicResource TextBrush}">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="14,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="Algorithm" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,3" />
                    <ComboBox x:Name="AlgorithmCombo" Width="180" DisplayMemberPath="Name"
                              SelectionChanged="AlgorithmCombo_SelectionChanged" />
                </StackPanel>

                <StackPanel Margin="0,0,18,0">
                    <TextBlock x:Name="SizeLabel" Text="Elements: 80" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,3" />
                    <Slider x:Name="SizeSlider" Width="150" Minimum="10" Maximum="400" Value="80"
                            IsSnapToTickEnabled="True" TickFrequency="10"
                            ValueChanged="SizeSlider_ValueChanged" />
                </StackPanel>

                <StackPanel Margin="0,0,18,0">
                    <TextBlock x:Name="DurationLabel" Text="Duration: 10 s" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,3" />
                    <Slider x:Name="DurationSlider" Width="150" Minimum="1" Maximum="60" Value="10"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="DurationSlider_ValueChanged" />
                </StackPanel>

                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="Theme" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,3" />
                    <ComboBox x:Name="ThemeCombo" Width="90" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Dark" IsSelected="True" />
                        <ComboBoxItem Content="Light" />
                    </ComboBox>
                </StackPanel>

                <Button x:Name="ShuffleButton" Content="Shuffle" Width="80" Height="30" Margin="0,10,8,0"
                        Click="ShuffleButton_Click" />
                <Button x:Name="RunButton" Content="▶ Run" Width="90" Height="30" Margin="0,10,8,0"
                        FontWeight="SemiBold" Click="RunButton_Click" />
                <Button x:Name="StopButton" Content="■ Stop" Width="80" Height="30" Margin="0,10,0,0"
                        IsEnabled="False" Click="StopButton_Click" />
                <Button x:Name="HowItWorksButton" Content="ℹ How it works" Width="110" Height="30" Margin="18,10,0,0"
                        Click="HowItWorksButton_Click" />
            </StackPanel>
        </Border>

        <!-- Algorithm details: complexity + memory -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource InfoPanelBrush}" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Time complexity:" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0" />
                <TextBlock x:Name="TimeBestText" Margin="0,0,14,0" />
                <TextBlock x:Name="TimeAvgText" Margin="0,0,14,0" />
                <TextBlock x:Name="TimeWorstText" Margin="0,0,28,0" />
                <TextBlock Text="Memory:" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0" />
                <TextBlock x:Name="SpaceText" Margin="0,0,14,0" />
                <TextBlock x:Name="AuxMemoryText" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" Padding="14,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="Ready" Width="220" />
                <TextBlock x:Name="ComparisonsText" Text="Comparisons: 0" Width="170" />
                <TextBlock x:Name="WritesText" Text="Swaps / writes: 0" Width="170" />
                <TextBlock x:Name="ProgressText" Text="" />
            </StackPanel>
        </Border>

        <!-- Visualization surface -->
        <Border Padding="12">
            <Canvas x:Name="BarCanvas" SizeChanged="BarCanvas_SizeChanged" ClipToBounds="True" />
        </Border>

    </DockPanel>
</Window>
